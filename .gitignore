target/
node_modules/
src-tauri/target/
bin/
# Build-owned temp dir: common.bat pins TMP/TEMP here so cl.exe cannot
# fail with D8050 when the caller's TMP is missing or unwritable
# (2026-10-02 post-mortem).
.tmp/
*.user
# 本地构建/测试重定向日志（统一放 logs/，不要散落在仓库根）
logs/
# 搜狗输入法等第三方进程从仓库根启动时落在 CWD 的运行日志
#（项目自身的 debug_log 写 %APPDATA%\niuma-timer\debug.log，不会落在这里）
debug.log
# Trae 编辑器本地文件（不该入库）
.trae/
# Python
__pycache__/

# AI 助手工作记忆（本地产物，不该入库）
.workbuddy/
.superpowers/

# Tauri 编译生成物（tauri-build 每次构建重新生成，真相源是
# src/main.rs 的 #[tauri::command] 与 capabilities/default.json）。
# 随仓库跟踪会因 LF/CRLF 行尾在每次编译后产生无意义 diff。
src-tauri/gen/
*.key
src-tauri/permissions/autogenerated/
